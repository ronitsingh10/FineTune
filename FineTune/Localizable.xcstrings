    "The system disabled FineTune's event tap — usually after a sleep/wake cycle or a main-thread stall. Retry to reinstall it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema desativou a torneira de evento do FineTune — geralmente após um ciclo de sono/vigília ou uma parada da linha principal. Tente reinstalá-lo novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统已停用 FineTune 的事件监听——通常发生在睡眠唤醒后或主线程卡顿时。请重试以重新安装。"
          }
        }
