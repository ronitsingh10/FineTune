    "NSAudioCaptureUsageDescription": {
      "comment": "Privacy - Audio Capture Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune needs access to control volume levels for individual applications."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FineTune precisa de acesso à captura de áudio para controlar o volume de cada app separadamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要音频采集权限，才能分别控制各个 App 的音量。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Privacy - Bluetooth Always Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "FineTune uses Bluetooth to connect paired audio devices from the menu bar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FineTune usa Bluetooth para conectar dispositivos de áudio emparelhados pela barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 使用蓝牙，以便直接从菜单栏连接已配对的音频设备。"
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "comment": "Copyright (human-readable)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
