        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "FineTune needs microphone access to capture audio from apps using input-capable devices."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FineTune precisa de acesso ao microfone para capturar áudio de apps que usam dispositivos de entrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要麦克风权限，才能从使用输入设备的 App 采集音频。"
          }
        }
      }
    }
  },
  "version": "1.0"
